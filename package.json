{
  "scripts": {
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:backend": "cypress run --spec 'cypress/e2e/back/**/*.cy.js'",
    "test:frontend": "cypress run --spec 'cypress/e2e/front/**/*.feature'",
    "test:report": "npm run test:clean && cypress run",
    "test:clean": "rm -rf cypress/reports cypress/screenshots cypress/videos",
    "report:open": "open cypress/reports/html/index.html",
    "cy:open": "cypress open"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress": "^15.21.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/**/steps/*.js"
  }
}
